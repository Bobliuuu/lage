; std/math: integer and list-of-number helpers.
(defn clamp [x lo hi]
  "x limited to the range [lo, hi]"
  (requires (<= lo hi))
  (cond (< x lo) lo (> x hi) hi :else x))

(defn _gcd [a b] (if (= b 0) a (_gcd b (mod a b))))

(defn gcd [a b]
  "greatest common divisor of two integers (always >= 0; (gcd 0 0) = 0)"
  (_gcd (abs a) (abs b)))

(defn lcm [a b]
  "least common multiple of two integers (always >= 0; 0 if either is 0)"
  (if (or (= a 0) (= b 0)) 0 (/ (abs (* a b)) (gcd a b))))

(defn sign [x] "-1, 0 or 1" (cond (< x 0) -1 (> x 0) 1 :else 0))

(defn even? [n] "true if the integer n is even" (= (mod n 2) 0))

(defn odd? [n] "true if the integer n is odd" (= (mod n 2) 1))

(defn _fact [n acc] (if (<= n 1) acc (_fact (- n 1) (* acc n))))

(defn factorial [n] "n! for an integer n >= 0" (requires (>= n 0)) (_fact n 1))

(defn _fib [n a b] (if (= n 0) a (_fib (- n 1) b (+ a b))))

(defn fib-iter [n]
  "the n-th Fibonacci number ((fib-iter 0) = 0), tail recursive"
  (requires (>= n 0))
  (_fib n 0 1))

(defn digits [n]
  "decimal digits of the integer |n| as a list ((digits 0) = [0])"
  (map (fn [c] (val (parse-int c))) (chars (str (abs n)))))

(defn mean [xs]
  "arithmetic mean of a non-empty list of numbers"
  (requires (> (len xs) 0))
  (/ (sum xs) (len xs)))

(defn median [xs]
  "median of a non-empty list of numbers (mean of the middle two when the length is even)"
  (requires (> (len xs) 0))
  (let [s (sort xs) n (len s) h (floor (/ n 2))]
    (if (= (mod n 2) 1) (nth s h) (/ (+ (nth s (- h 1)) (nth s h)) 2))))

(defn divmod [a b]
  "[quotient remainder] with floor semantics (remainder has the sign of b)"
  (requires (!= b 0))
  (let [r (mod a b)] [(/ (- a r) b) r]))

(test "clamp"
  (= (clamp 5 0 3) 3)
  (= (clamp -5 0 3) 0)
  (= (clamp 2 0 3) 2)
  (= (clamp 0 0 0) 0)
  (= (clamp 1.5 1 2) 1.5))

(test "gcd/lcm"
  (= (gcd 12 18) 6)
  (= (gcd 0 5) 5)
  (= (gcd 0 0) 0)
  (= (gcd -12 18) 6)
  (= (gcd 7 13) 1)
  (= (lcm 4 6) 12)
  (= (lcm 0 5) 0)
  (= (lcm -4 6) 12)
  (= (lcm 3 3) 3))

(test "sign/even/odd"
  (= (sign -7) -1)
  (= (sign 0) 0)
  (= (sign 2.5) 1)
  (= (even? 0) true)
  (= (even? 4) true)
  (= (even? -3) false)
  (= (odd? 3) true)
  (= (odd? -3) true)
  (= (odd? 0) false))

(test "factorial"
  (= (factorial 0) 1)
  (= (factorial 1) 1)
  (= (factorial 5) 120)
  (= (factorial 20) 2432902008176640000))

(test "fib-iter"
  (= (fib-iter 0) 0)
  (= (fib-iter 1) 1)
  (= (fib-iter 10) 55)
  (= (fib-iter 5000) (+ (fib-iter 4999) (fib-iter 4998))))

(test "digits"
  (= (digits 0) [0])
  (= (digits 1234) [1 2 3 4])
  (= (digits -905) [9 0 5]))

(test "mean/median"
  (= (mean [1 2 3]) 2)
  (= (mean [1 2]) 1.5)
  (= (mean [5]) 5)
  (= (median [3 1 2]) 2)
  (= (median [4 1 3 2]) 2.5)
  (= (median [7]) 7)
  (= (median [2 2]) 2)
  (= (median [-1 -3 -2]) -2))

(test "divmod"
  (= (divmod 7 2) [3 1])
  (= (divmod -7 2) [-4 1])
  (= (divmod 7 -2) [-4 -1])
  (= (divmod 0 5) [0 0])
  (= (divmod 6 3) [2 0]))
